# Auto-detect text files and perform LF normalisation
* text=auto eol=lf

# .NET and C# source files
*.cs     text diff=csharp eol=lf
*.csproj text eol=lf
*.props  text eol=lf
*.targets text eol=lf
*.slnx   text eol=lf
*.sln    text eol=crlf

# Configuration and documentation
*.json   text eol=lf
*.jsonc  text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.md     text eol=lf
*.editorconfig text eol=lf

# Web / Frontend files
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf

# Shell and Windows scripts
*.sh     text eol=lf
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.nupkg  binary
*.snupkg binary
*.dll    binary
*.exe    binary
*.pdb    binary
